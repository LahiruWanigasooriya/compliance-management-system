# Base URL of the Compliance Backend API (Required)
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Default Tenant ID for multi-tenant isolation (Optional / Set if required by your backend)
NEXT_PUBLIC_TENANT_ID=

# NextAuth Configuration
# Run `openssl rand -base64 32` or provide any secure random string
AUTH_SECRET=your-32-character-secret-key-goes-here

# Base URL where this Next.js app runs
AUTH_URL=http://localhost:3000
